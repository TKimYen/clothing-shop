// ============================================================
//  SCHEMA PRISMA - WEB BAN QUAN AO UNISEX
//  Dat file nay tai: prisma/schema.prisma
//  Sau do chay: npx prisma migrate dev --name init
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
//  ENUMS
// ============================================================

enum Role {
  CUSTOMER
  ADMIN
}

enum Season {
  SPRING_SUMMER // Xuan He
  FALL_WINTER // Thu Dong
}

enum DiscountType {
  PERCENT // giam theo % (vd: 15 = giam 15%)
  FIXED // giam so tien co dinh (vd: 50000 = giam 50.000d)
}

enum OrderStatus {
  PENDING // Cho xac nhan
  CONFIRMED // Da xac nhan
  SHIPPING // Dang giao
  DELIVERED // Da giao
  CANCELLED // Da huy
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  VNPAY
  MOMO
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

// ============================================================
//  NGUOI DUNG
// ============================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  addresses Address[]
  cart      Cart?
  orders    Order[]

  @@map("users")
}

model Address {
  id            String  @id @default(uuid())
  userId        String  @map("user_id")
  recipientName String  @map("recipient_name")
  phone         String
  fullAddress   String  @map("full_address")
  isDefault     Boolean @default(false) @map("is_default")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ============================================================
//  DANH MUC & BO SUU TAP
// ============================================================

model Category {
  id   String @id @default(uuid())
  name String // "Ao", "Quan"
  slug String @unique

  products Product[]

  @@map("categories")
}

model Collection {
  id          String    @id @default(uuid())
  name        String // "Thu Dong 2026"
  slug        String    @unique
  season      Season
  year        Int
  description String?
  bannerUrl   String?   @map("banner_url")
  startsAt    DateTime? @map("starts_at")
  isActive    Boolean   @default(true) @map("is_active")

  products Product[]

  @@map("collections")
}

// ============================================================
//  SAN PHAM
// ============================================================

model Product {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  // Gia nam o day, KHONG nam o variant.
  price        Decimal   @db.Decimal(12, 2)
  salePrice    Decimal?  @map("sale_price") @db.Decimal(12, 2)
  saleStartsAt DateTime? @map("sale_starts_at")
  saleEndsAt   DateTime? @map("sale_ends_at")

  categoryId   String  @map("category_id")
  collectionId String? @map("collection_id") // NULL = khong thuoc BST nao

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category   Category         @relation(fields: [categoryId], references: [id])
  collection Collection?      @relation(fields: [collectionId], references: [id])
  variants   ProductVariant[]
  images     ProductImage[]

  @@index([categoryId])
  @@index([collectionId])
  @@map("products")
}

model Size {
  id        String @id @default(uuid())
  label     String @unique // "S", "M", "L", "XL"
  sortOrder Int    @map("sort_order") // de sap xep S < M < L tren UI

  variants ProductVariant[]

  @@map("sizes")
}

model Color {
  id      String @id @default(uuid())
  name    String @unique // "Den", "Trang", "Be"
  hexCode String @map("hex_code") // "#000000" - dung ve swatch mau

  variants ProductVariant[]
  images   ProductImage[]

  @@map("colors")
}

// Moi dong = 1 to hop (san pham + size + mau) co the ban duoc.
// Day la thu khach hang thuc su mua.
model ProductVariant {
  id            String @id @default(uuid())
  productId     String @map("product_id")
  sizeId        String @map("size_id")
  colorId       String @map("color_id")
  sku           String @unique
  stockQuantity Int    @default(0) @map("stock_quantity")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size    Size    @relation(fields: [sizeId], references: [id])
  color   Color   @relation(fields: [colorId], references: [id])

  cartItems  CartItem[]
  orderItems OrderItem[]

  // Khong cho phep trung to hop san pham + size + mau
  @@unique([productId, sizeId, colorId])
  @@index([productId])
  @@map("product_variants")
}

// Anh gan voi (san pham + mau), KHONG gan voi variant.
// colorId = NULL nghia la anh chung cho moi mau (vd: anh bang size).
model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  colorId   String? @map("color_id")
  url       String
  altText   String? @map("alt_text")
  sortOrder Int     @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   Color?  @relation(fields: [colorId], references: [id])

  @@index([productId, colorId])
  @@map("product_images")
}

// ============================================================
//  GIO HANG
// ============================================================

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id") // moi user chi co 1 gio hang
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String @id @default(uuid())
  cartId    String @map("cart_id")
  variantId String @map("variant_id")
  quantity  Int    @default(1)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Them cung 1 variant 2 lan thi cong don quantity, khong tao dong moi
  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ============================================================
//  KHUYEN MAI
// ============================================================

model Coupon {
  id                String       @id @default(uuid())
  code              String       @unique // "SALE20"
  description       String?
  discountType      DiscountType @map("discount_type")
  discountValue     Decimal      @map("discount_value") @db.Decimal(12, 2)
  minOrderAmount    Decimal      @default(0) @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscountAmount Decimal?     @map("max_discount_amount") @db.Decimal(12, 2) // tran giam cho loai PERCENT
  maxUses           Int?         @map("max_uses") // NULL = khong gioi han
  usedCount         Int          @default(0) @map("used_count")
  startsAt          DateTime     @map("starts_at")
  endsAt            DateTime     @map("ends_at")
  isActive          Boolean      @default(true) @map("is_active")

  orders Order[]

  @@map("coupons")
}

// ============================================================
//  DON HANG
// ============================================================

model Order {
  id        String  @id @default(uuid())
  orderCode String  @unique @map("order_code") // ma don de khach tra cuu, vd "DH20260919001"
  userId    String  @map("user_id")
  couponId  String? @map("coupon_id")

  // Snapshot dia chi tai thoi diem dat hang.
  // KHONG tham chieu Address, vi khach co the sua/xoa dia chi sau do
  // va don hang cu phai giu nguyen noi da giao.
  recipientName   String @map("recipient_name")
  recipientPhone  String @map("recipient_phone")
  shippingAddress String @map("shipping_address")

  subtotal       Decimal     @db.Decimal(12, 2) // tong tien hang truoc giam gia
  discountAmount Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  shippingFee    Decimal     @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  totalAmount    Decimal     @map("total_amount") @db.Decimal(12, 2)
  status         OrderStatus @default(PENDING)
  note           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User        @relation(fields: [userId], references: [id])
  coupon  Coupon?     @relation(fields: [couponId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

// Luu snapshot ten/gia/size/mau tai thoi diem mua.
// Neu sau nay admin doi ten san pham hoac tang gia,
// don hang cu van hien thi dung thong tin luc khach mua.
model OrderItem {
  id        String @id @default(uuid())
  orderId   String @map("order_id")
  variantId String @map("variant_id")

  productName String  @map("product_name")
  sizeLabel   String  @map("size_label")
  colorName   String  @map("color_name")
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity    Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique @map("order_id")
  method        PaymentMethod
  status        PaymentStatus @default(UNPAID)
  transactionId String?       @map("transaction_id") // ma giao dich tu VNPay/Momo
  amount        Decimal       @db.Decimal(12, 2)
  paidAt        DateTime?     @map("paid_at")
  rawResponse   Json?         @map("raw_response") // luu nguyen phan hoi tu cong thanh toan de doi soat

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}
